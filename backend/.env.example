# AI学习助手 后端环境配置
# 复制此文件为 .env 并填写实际值

# 数据库
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/coaching

# JWT
SECRET_KEY=your-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_DAYS=30

# 对象存储（阿里云 OSS）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_DOMAIN=

# AI 配置（后台可动态切换，这里只是初始默认值）
DEFAULT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
